{
  "name": "codeform",
  "version": "0.2.0",
  "description": "Spec driven development for people who still want to write code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoenetic/codeform.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/zoenetic/codeform#readme",
  "bugs": "https://github.com/zoenetic/codeform/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json && cp ../README.md README.md && cp ../LICENSE LICENSE",
    "postpack": "rm -f README.md LICENSE",
    "test": "tsc --noEmit && tsx --test src/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:"
  }
}
